PORT=3001
WEB_ORIGIN=http://localhost:3000

# Public HTTPS address of this API. Jodo sends the payer's browser back to a
# callback URL built from it, so it must be reachable from the internet (an
# ngrok HTTPS URL while testing). No trailing slash needed.
API_PUBLIC_URL=

# Where a returning payer is sent after the payment callback, when the enquiry
# form has no redirect URL of its own. Only needed if the website is not on
# WEB_ORIGIN and not on the same address as this API.
WEB_PUBLIC_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Demo mode is disabled. The CRM always requires MySQL.
DEMO_MODE=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=attendance_app
MYSQL_PASSWORD=
MYSQL_DATABASE=attendance_biometric
MYSQL_CONNECTION_LIMIT=10

VITE_API_URL=http://127.0.0.1:3001/api

# AiSensy account credentials and campaign base URLs are maintained per
# WhatsApp account in the integrations table.
AISENSY_PROJECT_ID=
AISENSY_PROJECT_API_PASSWORD=
AISENSY_PROJECT_API_BASE_URL=https://api.aisensy.io/v1
AISENSY_LEGACY_PROJECT_API_BASE_URL=https://apis.aisensy.com/project-apis/v1/project
AISENSY_MAX_RETRIES=3

# Legacy project credential fallbacks. New integrations use their database row.
# AISENSY_PROJECT_ID_4=
# AISENSY_PROJECT_API_PASSWORD_4=
